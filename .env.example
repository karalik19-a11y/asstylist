# ─────────────────────────────────────────────────────────────────────────────
# asStylist — environment template
# Copy to `.env` and adjust. Every value below has a working default, so the
# app runs with an empty .env in demo/local mode (0 ₽, no secrets needed).
# ─────────────────────────────────────────────────────────────────────────────

# --- runtime ---------------------------------------------------------------
APP_ENV=development
DEBUG=true
# Demo mode = no Telegram token required, local user identities, offline first.
DEMO_MODE=true

# --- storage ---------------------------------------------------------------
DATABASE_URL=sqlite:///./data/asstylist.db
DATA_DIR=./data
STATIC_DIR=./frontend/dist
# Photos are analysed and then discarded by default (privacy). Set to true only
# if you need to keep the original upload on disk.
STORE_PHOTOS=false
UPLOAD_MAX_BYTES=10485760

# --- Telegram Mini App -----------------------------------------------------
# Leave empty to stay in demo mode. Get a token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Public HTTPS URL of the built Mini App, registered with @BotFather.
TELEGRAM_WEB_APP_URL=
TELEGRAM_AUTH_MAX_AGE_SEC=86400

# --- security --------------------------------------------------------------
CORS_ORIGINS=*
ADMIN_TOKEN=asstylist-local-admin

# --- budget ----------------------------------------------------------------
BUDGET_MAX_RUB=100000
BUDGET_MIN_RUB=10000

# --- vision / AI -----------------------------------------------------------
# local  = offline Pillow heuristics (default, free, no keys)
# openai = GPT-4o-mini vision (needs OPENAI_API_KEY)
# gemini = Gemini Flash vision (needs GEMINI_API_KEY)
AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- product verification layer -------------------------------------------
VERIFICATION_MIN_SCORE=0.6
VERIFICATION_TTL_DAYS=30
# Live HTTP checks of product URLs. Off by default: the demo must work offline
# and the allow-list below is the only thing we would ever call.
VERIFICATION_NETWORK_ENABLED=false
VERIFICATION_NETWORK_TIMEOUT_SEC=3
ALLOWED_PRODUCT_HOSTS=["asstylist.local","ozon.ru","wildberries.ru","lamoda.ru","yandex-market.ru","sokolov.ru","12storeez.com","uniqlo.com"]
# When true, products that failed verification may still reach a look (debug).
ALLOW_UNVERIFIED_PRODUCTS=false

# --- fashion engine --------------------------------------------------------
# Подбор вещей и свободный поиск выполняет движок ASSTYLIST Fashion Engine
# (Python-порт https://github.com/karalik19-a11y/-), работающий офлайн:
# расширение запроса → Fashion Intelligence → Taste/anti-generic → архитектура
# образа → оценка → критик. Ни сети, ни ключей, ни внешних сервисов.
FASHION_ENGINE_ENABLED=true
# hybrid = движок собирает образ, приложение страхует слоты и бюджет;
# engine = только движок; legacy = прежний ранжировщик приложения.
FASHION_ENGINE_MODE=hybrid
# Разрешить откат на прежний ранжировщик, если движок не собрал образ.
FASHION_ENGINE_ALLOW_FALLBACK=true
# Потолки пайплайна. Для каталога ~100 позиций не срабатывают.
FASHION_ENGINE_MAX_PRODUCTS=120
FASHION_ENGINE_LIMIT_PER_QUERY=130
FASHION_ENGINE_MAX_CARDS=160
FASHION_ENGINE_MIN_CONFIDENCE=0.6
# Справочный mock-каталог дизайнерских архетипов (Ann Demeulemeester, Rick
# Owens, Margiela…): даёт движку нишевый референс-ряд, ссылки ведут на живой
# поиск ритейлера (Farfetch). Включён по умолчанию.
FASHION_ENGINE_ENABLE_MOCK=true
# Вес оценки образа движка в итоговом индексе: 0.7 * приложение + 0.3 * движок.
FASHION_ENGINE_SCORE_WEIGHT=0.3

# --- живой web-поиск вещей ---------------------------------------------------
# Выдача движка пополняется живыми находками из интернета в реальном времени:
# позиция приходит с названием, ценой, ссылкой и ФОТО товара с источника.
# Работает при наличии любого из источников ниже; без ключей — только локальный
# поиск. Мастер-выключатель:
WEB_SEARCH_ENABLED=true
# 1) SerpAPI — Google Shopping (https://serpapi.com, 100 запросов/мес бесплатно).
SERPAPI_API_KEY=
# 2) Google Custom Search (Programmable Search Engine) — запросы вида «купить …».
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
# 3) Партнёрский фид магазина — JSON-массив [{name, brand, price, currency,
#    image, url, tags?}], курсируется как первичный источник:
PRODUCT_FEED_URL=
# Курсы валют → RUB для нормализации цен живых находок (JSON-словарь):
FX_RATES={"USD": 92.0, "EUR": 100.0, "GBP": 118.0}

# --- ranking ---------------------------------------------------------------
# Optional override, e.g. to make style dominate:
# RANKING_WEIGHTS_JSON={"style":0.4,"mood":0.15,"silhouette":0.15,"color":0.15,"formality":0.05,"season":0.03,"value":0.05,"verification":0.02}
RANKING_WEIGHTS_JSON=
